<policy #example-server.browser_api_contract { kind = "policy" } [
  <desc ?>example-browser 只通过私有 HTTP API 使用本体能力；浏览器不拥有 Cozo、schema 或治理状态的写入权。</?>
  <behavior ?>behavior://dotnet-example-server/requirements/browser-compatible-demo-api</?>
  <behavior ?>behavior://dotnet-example-server/requirements/governance-api</?>
  <behavior ?>behavior://dotnet-example-server/requirements/browser-cors</?>
]>
